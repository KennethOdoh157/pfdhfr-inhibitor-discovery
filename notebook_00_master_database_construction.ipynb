    "# DIAGNOSTIC: Inspect NPASS compounds with failed descriptor computation\n",
    "# Determines whether missing descriptors are due to metals, unusual valences,\n",
    "# or genuinely malformed SMILES — informs cleaning strategy for notebook 01\n",
    "# =============================================================================\n",
    "\n",
    "failed_mask = npass_master[\"mw\"].isna()\n",
    "failed_df   = npass_master[failed_mask][[\"np_id\", \"pref_name\", \"smiles_npass\"]].copy()\n",
    "\n",
    "print(f\"NPASS compounds with failed descriptor computation: {len(failed_df)}\")\n",
    "print(f\"\\nFirst 20 failed SMILES:\\n\")\n",
    "\n",
    "for _, row in failed_df.head(20).iterrows():\n",
    "    print(f\"  {row['np_id']:12s}  {str(row['pref_name'])[:30]:30s}  {str(row['smiles_npass'])[:70]}\")\n",
    "\n",
    "# Check for common failure causes\n",
    "dot_count = failed_df[\"smiles_npass\"].str.contains(r\"\\.\", na=False, regex=True).sum()\n",
    "\n",
    "print(f\"\\nFailure pattern analysis:\")\n",
    "print(f\"  SMILES is NaN or empty : {failed_df['smiles_npass'].isna().sum()}\")\n",
    "print(f\"  SMILES contains metals : {failed_df['smiles_npass'].str.contains('[Fe]|[Cu]|[Zn]|[Co]|[Mg]|[Ca]|[Na]|[K]', na=False, regex=True).sum()}\")\n",
