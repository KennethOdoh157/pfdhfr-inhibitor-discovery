   "source": [
    "# =============================================================================\n",
    "# SECTION 3: EXTRACT DHFR-RELEVANT ACTIVITY DATA FROM NPASS\n",
    "#\n",
    "# This serves two purposes:\n",
    "#   (a) Identifies any natural products with KNOWN DHFR activity in NPASS\n",
    "#       → these become an independent validation set for our QSAR model\n",
    "#   (b) Flags compounds in COCONUT that have NPASS-confirmed DHFR activity\n",
    "#\n",
    "# We search for dihydrofolate reductase in target_name (case-insensitive).\n",
    "# =============================================================================\n",
    "\n",
    "# Step 3a: Identify DHFR targets\n",
    "dhfr_targets = npass_target[\n",
    "    npass_target[\"target_name\"].str.contains(\n",
    "        \"dihydrofolate reductase|DHFR\", case=False, na=False\n",
    "    )\n",
    "]\n",
    "print(f\"DHFR targets found in NPASS: {len(dhfr_targets)}\")\n",
    "print(dhfr_targets[[\"target_id\", \"target_name\", \"target_organism\"]].to_string())\n",
    "\n",
    "# Step 3b: Filter activity table to DHFR targets only\n",
    "dhfr_target_ids = set(dhfr_targets[\"target_id\"].tolist())\n",
    "\n",
    "dhfr_activity = npass_activity[\n",
    "    npass_activity[\"target_id\"].isin(dhfr_target_ids)\n",
    "].copy()\n",
    "\n",
    "print(f\"\\nNPASS DHFR activity records: {len(dhfr_activity)}\")\n",
    "print(f\"Unique compounds with DHFR activity: {dhfr_activity['np_id'].nunique()}\")\n",
    "\n",
    "# Step 3c: Keep best (most potent) activity value per compound\n",
    "# Convert activity_value to float for comparison\n",
    "dhfr_activity[\"activity_value_num\"] = pd.to_numeric(\n",
    "    dhfr_activity[\"activity_value\"], errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Aggregate: keep the minimum IC50/Ki per compound (most potent record)\n",
    "dhfr_best = (\n",
    "    dhfr_activity\n",
    "    .sort_values(\"activity_value_num\")\n",
    "    .groupby(\"np_id\")\n",
    "    .first()\n",
    "    .reset_index()\n",
    "    [[\"np_id\", \"activity_type\", \"activity_value_num\", \"activity_units\",\n",
    "      \"activity_relation\", \"assay_organism\"]]\n",
    "    .rename(columns={\n",
    "        \"activity_type\"       : \"dhfr_activity_type\",\n",
    "        \"activity_value_num\"  : \"dhfr_activity_value\",\n",
    "        \"activity_units\"      : \"dhfr_activity_units\",\n",
    "        \"activity_relation\"   : \"dhfr_activity_relation\",\n",
    "        \"assay_organism\"      : \"dhfr_assay_organism\",\n",
    "    })\n",
    ")\n",
    "\n",
    "print(f\"\\nCompounds with best DHFR activity extracted: {len(dhfr_best)}\")"
   ]
