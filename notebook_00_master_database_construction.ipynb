    "# =============================================================================\n",
    "# SECTION 5 : PARSE COCONUT SDF — EXTRACT PRE-COMPUTED FIELDS\n",
    "#\n",
    "# COCONUT (Oct 2024) pre-computes all major physicochemical descriptors.\n",
    "# We extract them directly from the SDF rather than recomputing with RDKit.\n",
    "# This avoids ~2 hours of redundant descriptor calculation for 695K compounds.\n",
    "#\n",
    "# Key fields captured:\n",
    "#   - Identifiers: identifier, standard_inchi_key, name\n",
    "#   - Descriptors: molecular_weight, alogp, tpsa, hbd, hba, qed, violations\n",
    "#   - Classification: np_classifier_pathway, superclass, class\n",
    "#   - Source: organisms (plant sources embedded in COCONUT)\n",
    "# =============================================================================\n",
    "\n",
    "print(\"Parsing COCONUT SDF with full field extraction...\")\n",
    "print(\"This will take 10–20 minutes for 695K compounds.\\n\")\n",
    "from rdkit import RDLogger\n",
    "RDLogger.DisableLog('rdApp.*')\n",
    "\n",
    "supplier = Chem.SDMolSupplier(\n",
    "    PATHS[\"coconut_sdf\"],\n",
    "    removeHs=True,\n",
    "    sanitize=False   # We sanitize manually to catch and skip malformed structures\n",
    ")\n",
    "# Inspect property names from first valid molecule\n",
    "for mol in supplier:\n",
    "    if mol is not None:\n",
    "        print(\"COCONUT SDF property names (first valid molecule):\")\n",
    "        print(list(mol.GetPropsAsDict().keys()))\n",
    "        break\n",
    "# Re-open supplier (iterator is exhausted after inspection)   \n",
    "supplier = Chem.SDMolSupplier(\n",
    "    PATHS[\"coconut_sdf\"],\n",
    "    removeHs=True,\n",
    "    sanitize=False\n",
    ")\n",
    "\n",
    "coconut_records = []\n",
    "n_total = 0\n",
    "n_invalid = 0\n",
    "n_sanitize_fail = 0\n",
    "\n",
    "for mol in supplier:\n",
    "    n_total += 1\n",
    "\n",
    "    if mol is None:\n",
    "        n_invalid += 1\n",
    "        continue\n",
    "\n",
    "    try:\n",
    "        Chem.SanitizeMol(mol)\n",
    "    except Exception:\n",
    "        n_sanitize_fail += 1\n",
    "        continue\n",
    "\n",
    "    props = mol.GetPropsAsDict()\n",
    "\n",
    "    try:\n",
    "        smiles = Chem.MolToSmiles(mol, canonical=True)\n",
    "    except Exception:\n",
    "        n_sanitize_fail += 1\n",
    "        continue\n",
    "\n",
    "    coconut_records.append({\n",
    "        # ── Identifiers ───────────────────────────────────────────────────\n",
    "        \"coconut_id\"          : props.get(\"identifier\", \"\"),\n",
    "        \"smiles_coconut\"      : smiles,\n",
    "        \"inchikey_coconut\"    : props.get(\"standard_inchi_key\", \"\"),\n",
    "        \"name_coconut\"        : props.get(\"name\", \"\"),\n",
    "        \"iupac_name_coconut\"  : props.get(\"iupac_name\", \"\"),\n",
    "        \"molecular_formula\"   : props.get(\"molecular_formula\", \"\"),\n",
    "\n",
    "        # ── Pre-computed physicochemical descriptors ──────────────────────\n",
    "        \"mw_coconut\"          : props.get(\"molecular_weight\", np.nan),\n",
    "        \"alogp_coconut\"       : props.get(\"alogp\", np.nan),\n",
    "        \"tpsa_coconut\"        : props.get(\"topological_polar_surface_area\", np.nan),\n",
    "        \"hba_coconut\"         : props.get(\"hydrogen_bond_acceptors_lipinski\", np.nan),\n",
    "        \"hbd_coconut\"         : props.get(\"hydrogen_bond_donors_lipinski\", np.nan),\n",
    "        \"rot_bonds_coconut\"   : props.get(\"rotatable_bond_count\", np.nan),\n",
    "        \"qed_coconut\"         : props.get(\"qed_drug_likeliness\", np.nan),\n",
    "        \"lipinski_violations\" : props.get(\"lipinski_rule_of_five_violations\", np.nan),\n",
    "        \"aromatic_rings\"      : props.get(\"aromatic_rings_count\", np.nan),\n",
    "        \"frac_csp3\"           : props.get(\"fractioncsp3\", np.nan),\n",
    "        \"np_likeness_score\"   : props.get(\"np_likeness\", np.nan),\n",
    "\n",
    "        # ── Natural product classification (NP Classifier) ────────────────\n",
    "        \"np_pathway\"          : props.get(\"np_classifier_pathway\", \"\"),\n",
    "        \"np_superclass\"       : props.get(\"np_classifier_superclass\", \"\"),\n",
    "        \"np_class\"            : props.get(\"np_classifier_class\", \"\"),\n",
    "        \"chemical_class\"      : props.get(\"chemical_class\", \"\"),\n",
    "        \"chemical_superclass\" : props.get(\"chemical_super_class\", \"\"),\n",
    "        \"direct_parent\"       : props.get(\"direct_parent_classification\", \"\"),\n",
    "\n",
    "        # ── Source organisms (plant provenance) ───────────────────────────\n",
    "        # COCONUT stores organism names as a pipe-separated or comma-separated\n",
    "        # string in the 'organisms' field\n",
    "        \"coconut_organisms\"   : props.get(\"organisms\", \"\"),\n",
    "        \"collections\"         : props.get(\"collections\", props.get(\"COLLECTIONS\", \"\")),\n",
    "\n",
    "        # ── Sugar flags ───────────────────────────────────────────────────\n",
    "        \"contains_sugar\"      : props.get(\"contains_sugar\", \"\"),\n",
    "        \"contains_ring_sugars\": props.get(\"contains_ring_sugars\", \"\"),\n",
    "\n",
    "        # ── Literature ────────────────────────────────────────────────────\n",
    "        \"dois\"                : props.get(\"dois\", \"\"),\n",
    "    })\n",
    "\n",
    "    if n_total % 50000 == 0:\n",
    "        print(f\"  Processed {n_total:,} | Valid: {len(coconut_records):,}\")\n",
    "\n",
    "coconut_df = pd.DataFrame(coconut_records)\n",
    "coconut_df[\"source_database\"] = \"COCONUT\"\n",
    "\n",
    "# Convert numeric columns from string to float (SDF stores everything as string)\n",
    "numeric_cols = [\"mw_coconut\", \"alogp_coconut\", \"tpsa_coconut\", \"hba_coconut\",\n",
    "                \"hbd_coconut\", \"rot_bonds_coconut\", \"qed_coconut\",\n",
    "                \"lipinski_violations\", \"aromatic_rings\", \"frac_csp3\",\n",
    "                \"np_likeness_score\"]\n",
    "for col in numeric_cols:\n",
    "    coconut_df[col] = pd.to_numeric(coconut_df[col], errors=\"coerce\")\n",
    "\n",
    "print(f\"\\nCOCONUT parsing complete: {len(coconut_df):,} valid compounds\")\n",
    "print(f\"\\nDescriptor coverage (non-null %):\")\n",
    "for col in numeric_cols:\n",
    "    pct = coconut_df[col].notna().mean() * 100\n",
    "    print(f\"  {col:30s}: {pct:.1f}%\")"
   ]
  },
