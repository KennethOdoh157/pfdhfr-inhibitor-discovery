    "# =============================================================================\n",
    "# SECTION 7: COMPUTE PHYSICOCHEMICAL DESCRIPTORS FOR NPASS COMPOUNDS\n",
    "#\n",
    "# Unlike COCONUT, NPASS does not pre-compute descriptors — we calculate them\n",
    "# from SMILES using RDKit. These are used for:\n",
    "#   (a) Drug-likeness filtering (Lipinski Ro5)\n",
    "#   (b) Applicability domain assessment in QSAR notebook\n",
    "#   (c) Publication-quality compound property tables\n",
    "#\n",
    "# Descriptors computed: MW, LogP, HBD, HBA, TPSA, RotBonds, QED, rings\n",
    "# Runtime: ~2–5 minutes for 203K compounds\n",
    "# =============================================================================\n",
    "\n",
    "from rdkit.Chem import QED\n",
    "\n",
    "def compute_descriptors(smiles):\n",
    "    \"\"\"\n",
    "    Compute physicochemical descriptors from a SMILES string.\n",
    "    Returns a dict with NaN values for invalid or missing structures.\n",
    "    \"\"\"\n",
    "    null_result = {\n",
    "        \"mw\": np.nan, \"logp\": np.nan, \"hbd\": np.nan, \"hba\": np.nan,\n",
    "        \"tpsa\": np.nan, \"rot_bonds\": np.nan, \"qed\": np.nan,\n",
    "        \"n_rings\": np.nan, \"n_aromatic_rings\": np.nan,\n",
    "    }\n",
    "    if pd.isna(smiles) or smiles == \"\":\n",
    "        return null_result\n",
    "    try:\n",
    "        mol = Chem.MolFromSmiles(str(smiles))\n",
    "        if mol is None:\n",
    "            return null_result\n",
    "        return {\n",
    "            \"mw\"              : Descriptors.MolWt(mol),\n",
    "            \"logp\"            : Descriptors.MolLogP(mol),\n",
    "            \"hbd\"             : rdMolDescriptors.CalcNumHBD(mol),\n",
    "            \"hba\"             : rdMolDescriptors.CalcNumHBA(mol),\n",
    "            \"tpsa\"            : Descriptors.TPSA(mol),\n",
    "            \"rot_bonds\"       : rdMolDescriptors.CalcNumRotatableBonds(mol),\n",
    "            \"qed\"             : QED.qed(mol),\n",
    "            \"n_rings\"         : rdMolDescriptors.CalcNumRings(mol),\n",
    "            \"n_aromatic_rings\": rdMolDescriptors.CalcNumAromaticRings(mol),\n",
    "        }\n",
    "    except Exception:\n",
    "        return null_result\n",
    "\n",
    "print(\"Computing RDKit descriptors for 203K NPASS compounds...\")\n",
    "print(\"Expected runtime: 2–5 minutes\\n\")\n",
    "\n",
    "desc_list = [compute_descriptors(s) for s in npass_master[\"smiles_npass\"]]\n",
    "desc_df   = pd.DataFrame(desc_list)\n",
    "\n",
    "npass_master = pd.concat(\n",
    "    [npass_master.reset_index(drop=True), desc_df.reset_index(drop=True)],\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "print(\"Descriptor computation complete.\")\n",
    "print(f\"\\nCoverage (non-null %):\")\n",
    "for col in desc_df.columns:\n",
    "    pct = npass_master[col].notna().mean() * 100\n",
    "    print(f\"  {col:20s}: {pct:.1f}%\")"
   ]
  },
