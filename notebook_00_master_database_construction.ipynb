    "# =============================================================================\n",
    "# SECTION 8b: CLEAN NPASS — REMOVE NON-DRUG-LIKE ENTRIES\n",
    "#\n",
    "# 1,415 compounds (0.7%) failed RDKit descriptor computation due to:\n",
    "#   - Permanent charges / zwitterions ([N+], [OH+], [S-])\n",
    "#   - Salt forms and mixtures (SMILES containing '.')\n",
    "#   - Non-standard valences (pentavalent N, etc.)\n",
    "#\n",
    "# These are excluded as they are incompatible with standard QSAR modeling\n",
    "# and are not relevant to oral drug discovery.\n",
    "#\n",
    "# This is documented in Methods as standard cheminformatics practice.\n",
    "# Reference: Bender et al., J. Chem. Inf. Model., 2009\n",
    "# =============================================================================\n",
    "\n",
    "n_before = len(npass_master)\n",
    "\n",
    "# Remove compounds where descriptor computation failed (mw is NaN)\n",
    "# These are exclusively the problematic structures identified in the diagnostic\n",
    "npass_master = npass_master[npass_master[\"mw\"].notna()].copy().reset_index(drop=True)\n",
    "\n",
    "n_after  = len(npass_master)\n",
    "n_removed = n_before - n_after\n",
    "\n",
    "print(f\"NPASS cleaning summary:\")\n",
    "print(f\"  Before : {n_before:,} compounds\")\n",
    "print(f\"  Removed: {n_removed:,} ({n_removed/n_before*100:.1f}%) — charged/mixed/non-standard structures\")\n",
    "print(f\"  After  : {n_after:,} compounds\")\n",
    "print(f\"\\nRetained DHFR-active compounds : {npass_master['has_npass_dhfr_activity'].sum()}\")\n",
    "print(f\"Retained African NPs           : {npass_master['is_african_np'].sum()}\")\n",
    "\n",
    "# Overwrite the saved parquet with the cleaned version\n",
    "npass_master.to_parquet(os.path.join(PATHS[\"output_dir\"], \"npass_master.parquet\"), index=False)\n",
    "print(f\"\\nnpass_master.parquet overwritten with cleaned dataset.\")\n",
    "print(f\"Final shape: {npass_master.shape}\")"
   ]
