   "source": [
    "# =============================================================================\n",
    "# SECTION 1: LOAD AND MERGE ALL NPASS 3.0 TABLES\n",
    "#\n",
    "# Join chain:\n",
    "#   structure (np_id, SMILES, InChIKey)\n",
    "#   + general  (np_id → preferred name, external IDs)\n",
    "#   + species_pair (np_id → org_id, collection location)\n",
    "#   + species_info (org_id → species name, genus, family, kingdom)\n",
    "# =============================================================================\n",
    "\n",
    "print(\"Loading NPASS tables...\")\n",
    "\n",
    "# ── Core tables ───────────────────────────────────────────────────────────────\n",
    "npass_struct   = pd.read_csv(PATHS[\"npass_structure\"],   sep=\"\\t\", dtype=str)\n",
    "npass_general  = pd.read_csv(PATHS[\"npass_general\"],     sep=\"\\t\", dtype=str)\n",
    "npass_sp_pair  = pd.read_csv(PATHS[\"npass_species_pair\"],sep=\"\\t\", dtype=str)\n",
    "npass_sp_info  = pd.read_csv(PATHS[\"npass_species_info\"],sep=\"\\t\", dtype=str)\n",
    "npass_activity = pd.read_csv(PATHS[\"npass_activity\"],    sep=\"\\t\", dtype=str)\n",
    "npass_target   = pd.read_csv(PATHS[\"npass_target\"],      sep=\"\\t\", dtype=str)\n",
    "npass_toxicity = pd.read_csv(PATHS[\"npass_toxicity\"],    sep=\"\\t\", dtype=str)\n",
    "\n",
    "print(f\"  Structure   : {len(npass_struct):,} compounds\")\n",
    "print(f\"  General info: {len(npass_general):,} compounds\")\n",
    "print(f\"  Species pair: {len(npass_sp_pair):,} records\")\n",
    "print(f\"  Species info: {len(npass_sp_info):,} species\")\n",
    "print(f\"  Activity    : {len(npass_activity):,} records\")\n",
    "print(f\"  Target      : {len(npass_target):,} targets\")\n",
    "print(f\"  Toxicity    : {len(npass_toxicity):,} records\")"
   ]
  },
