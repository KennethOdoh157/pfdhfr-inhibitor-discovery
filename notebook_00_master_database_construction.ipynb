    "# =============================================================================\n",
    "# SECTION 8: APPLY LIPINSKI FILTER AND AFRICAN NP FLAGS\n",
    "#\n",
    "# NPASS: African flag via InChIKey-14 matching against AfroDb set\n",
    "# COCONUT: African flag via 'collections' field containing 'AfroDB'\n",
    "#          (AfroDb is a COCONUT collection — membership is pre-encoded)\n",
    "#\n",
    "# Lipinski filter applied to NPASS (relaxed: MW ≤ 600, max 1 violation).\n",
    "# COCONUT already has lipinski_violations pre-computed — used directly.\n",
    "# =============================================================================\n",
    "\n",
    "# ── NPASS: Lipinski filter ────────────────────────────────────────────────────\n",
    "def lipinski_pass_npass(row, max_violations=1):\n",
    "    \"\"\"\n",
    "    Relaxed Lipinski filter for natural products.\n",
    "    Allows 1 violation — consistent with 'beyond Ro5' NP drug discovery.\n",
    "    \"\"\"\n",
    "    violations = 0\n",
    "    if pd.isna(row[\"mw\"])   or row[\"mw\"]   > 600: violations += 1\n",
    "    if pd.isna(row[\"logp\"]) or row[\"logp\"]  > 5:  violations += 1\n",
    "    if pd.isna(row[\"hbd\"])  or row[\"hbd\"]   > 5:  violations += 1\n",
    "    if pd.isna(row[\"hba\"])  or row[\"hba\"]   > 10: violations += 1\n",
    "    return violations <= max_violations\n",
    "\n",
    "npass_master[\"lipinski_pass\"] = npass_master.apply(lipinski_pass_npass, axis=1)\n",
    "\n",
    "# ── NPASS: African NP flag via InChIKey-14 matching ──────────────────────────\n",
    "npass_master[\"inchikey_14\"]  = npass_master[\"inchikey_npass\"].str[:14]\n",
    "npass_master[\"is_african_np\"] = npass_master[\"inchikey_14\"].isin(afrodb_inchikey_set)\n",
    "\n",
    "# ── COCONUT: African NP flag via collections field ───────────────────────────\n",
    "# The collections field is pipe-separated: e.g. 'AfroDB|ZINC NP|KNApSaCK'\n",
    "coconut_df[\"is_african_np\"] = coconut_df[\"collections\"].str.contains(\n",
    "    \"AfroDB\", na=False, case=False\n",
    ")\n",
    "\n",
    "# ── COCONUT: Lipinski pass using pre-computed violations ─────────────────────\n",
    "coconut_df[\"lipinski_pass\"] = coconut_df[\"lipinski_violations\"].apply(\n",
    "    lambda x: x <= 1 if pd.notna(x) else False\n",
    ")\n",
    "\n",
    "# ── COCONUT: Cross-link to NPASS via InChIKey-14 ─────────────────────────────\n",
    "coconut_df[\"inchikey_14\"]   = coconut_df[\"inchikey_coconut\"].str[:14]\n",
    "npass_ik14_map              = npass_master.set_index(\"inchikey_14\")[\"np_id\"].to_dict()\n",
    "coconut_df[\"npass_np_id\"]   = coconut_df[\"inchikey_14\"].map(npass_ik14_map)\n",
    "coconut_df[\"in_npass\"]      = coconut_df[\"npass_np_id\"].notna()\n",
    "\n",
    "# ── Summary statistics ────────────────────────────────────────────────────────\n",
    "print(\"=\" * 55)\n",
    "print(\"DATABASE FLAGGING SUMMARY\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "print(f\"\\nNPASS (203,390 compounds):\")\n",
    "print(f\"  Lipinski pass (relaxed)    : {npass_master['lipinski_pass'].sum():>8,}\")\n",
    "print(f\"  African NP (AfroDb match)  : {npass_master['is_african_np'].sum():>8,}\")\n",
    "print(f\"  With DHFR activity         : {npass_master['has_npass_dhfr_activity'].sum():>8,}\")\n",
    "print(f\"  African + DHFR activity    : {(npass_master['is_african_np'] & npass_master['has_npass_dhfr_activity']).sum():>8,}\")\n",
    "\n",
    "print(f\"\\nCOCONUT (695,133 compounds):\")\n",
    "print(f\"  Lipinski pass (relaxed)    : {coconut_df['lipinski_pass'].sum():>8,}\")\n",
    "print(f\"  African NP (AfroDB tag)    : {coconut_df['is_african_np'].sum():>8,}\")\n",
    "print(f\"  Cross-linked to NPASS      : {coconut_df['in_npass'].sum():>8,}\")\n",
    "print(f\"  African + Lipinski pass    : {(coconut_df['is_african_np'] & coconut_df['lipinski_pass']).sum():>8,}\")"
   ]
