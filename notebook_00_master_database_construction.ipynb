   "source": [
    "# =============================================================================\n",
    "# SECTION 6 : BUILD AFRODB INCHIKEY SET FOR NPASS FLAGGING\n",
    "#\n",
    "# AfroDb is a curated subset of African plant-derived natural products.\n",
    "# In COCONUT, AfroDb membership is already encoded in the 'collections' field\n",
    "# (see Cell 6 output — compounds show 'AfroDB' in collections).\n",
    "# Therefore, for COCONUT we use the collections flag directly (Cell 10).\n",
    "#\n",
    "# For NPASS, which has no collections field, we still need InChIKey matching.\n",
    "# We extract InChIKey-14 (connectivity layer only) from the AfroDb SDF here.\n",
    "#\n",
    "# NOTE: The AfroDb SDF uses the same schema as COCONUT — it IS a COCONUT export.\n",
    "# The InChIKey field is 'standard_inchi_key'.\n",
    "# =============================================================================\n",
    "\n",
    "print(\"Building AfroDb InChIKey set for NPASS cross-referencing...\")\n",
    "\n",
    "afrodb_supplier = Chem.SDMolSupplier(\n",
    "    PATHS[\"afrodb_sdf\"],\n",
    "    removeHs=True,\n",
    "    sanitize=False\n",
    ")\n",
    "\n",
    "afrodb_inchikeys = []\n",
    "n_parsed = 0\n",
    "\n",
    "for mol in afrodb_supplier:\n",
    "    if mol is None:\n",
    "        continue\n",
    "    props = mol.GetPropsAsDict()\n",
    "\n",
    "    # AfroDb SDF uses COCONUT schema — correct field is 'standard_inchi_key'\n",
    "    ik = props.get(\"standard_inchi_key\", \"\")\n",
    "    if ik and ik != \"nan\":\n",
    "        afrodb_inchikeys.append(ik[:14])  # Connectivity layer only\n",
    "    n_parsed += 1\n",
    "\n",
    "afrodb_inchikey_set = set(afrodb_inchikeys)\n",
    "\n",
    "print(f\"AfroDb SDF compounds parsed : {n_parsed:,}\")\n",
    "print(f\"Valid InChIKey-14s extracted : {len(afrodb_inchikey_set):,}\")\n",
    "print(f\"Sample InChIKey-14s          : {list(afrodb_inchikey_set)[:5]}\")"
   ]
