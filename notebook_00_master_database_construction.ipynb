   "source": [
    "# =============================================================================\n",
    "# SECTION 4: ASSEMBLE COMPLETE NPASS COMPOUND TABLE\n",
    "#\n",
    "# Join order:\n",
    "#   structure → general info → plant annotation → DHFR activity\n",
    "#\n",
    "# All joins are LEFT joins — every compound in structure table is preserved.\n",
    "# Compounds without plant data or DHFR activity get NaN in those columns.\n",
    "# =============================================================================\n",
    "\n",
    "print(\"Assembling NPASS master table...\")\n",
    "\n",
    "# Start from structure (authoritative SMILES and InChIKey)\n",
    "npass_master = npass_struct.copy()\n",
    "npass_master.columns = [\"np_id\", \"inchi\", \"inchikey_npass\", \"smiles_npass\"]\n",
    "\n",
    "# Join general info\n",
    "npass_master = npass_master.merge(\n",
    "    npass_general[[\n",
    "        \"np_id\", \"pref_name\", \"iupac_name\", \"chembl_id\",\n",
    "        \"pubchem_id\", \"num_of_organism\", \"num_of_target\"\n",
    "    ]],\n",
    "    on=\"np_id\", how=\"left\"\n",
    ")\n",
    "\n",
    "# Join plant annotation (species, family, location)\n",
    "npass_master = npass_master.merge(plant_annotation, on=\"np_id\", how=\"left\")\n",
    "\n",
    "# Join DHFR activity\n",
    "npass_master = npass_master.merge(dhfr_best, on=\"np_id\", how=\"left\")\n",
    "\n",
    "# Add a flag column: does this compound have known DHFR activity in NPASS?\n",
    "npass_master[\"has_npass_dhfr_activity\"] = npass_master[\"dhfr_activity_value\"].notna()\n",
    "\n",
    "# Add source label\n",
    "npass_master[\"source_database\"] = \"NPASS\"\n",
    "\n",
    "print(f\"NPASS master table: {len(npass_master):,} compounds\")\n",
    "print(f\"  With plant annotation : {npass_master['source_species'].notna().sum():,}\")\n",
    "print(f\"  With DHFR activity    : {npass_master['has_npass_dhfr_activity'].sum():,}\")\n",
    "print(f\"\\nColumns: {list(npass_master.columns)}\")"
   ]
