    "# =============================================================================\n",
    "# NOTEBOOK: notebook_00_master_database_construction.ipynb\n",
    "# PURPOSE:  Build an integrated master natural product database from NPASS 3.0,\n",
    "#           COCONUT (Oct 2024), and AfroDb (Apr 2026) for use in all downstream\n",
    "#           QSAR, virtual screening, and docking analyses.\n",
    "#\n",
    "# OUTPUT:   data/master_np_database.parquet\n",
    "#           data/master_np_database_summary.csv   (human-readable preview)\n",
    "#\n",
    "# AUTHOR:   Odoh Kenneth Chidiebere\n",
    "# DATE:     April 2026\n",
    "# =============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from rdkit import Chem\n",
    "from rdkit.Chem import Descriptors, rdMolDescriptors\n",
    "from rdkit.Chem.MolStandardize import rdMolStandardize\n",
    "import os\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ── Path configuration ────────────────────────────────────────────────────────\n",
    "BASE_NP   = r\"C:\\my_projects_all\\portfolio_projects\\african_natural_product_databases\"\n",
    "BASE_PROJ = r\"C:\\my_projects_all\\portfolio_projects\\cheminformatics_course_claudeai\"\n",
    "MSC_PROJ  = r\"C:\\my_projects_all\\portfolio_projects\\Msc_project\"\n",
    "PATHS = {\n",
    "    \"npass_structure\"  : os.path.join(BASE_NP, \"NPASS3.0_naturalproducts_structure.txt\"),\n",
    "    \"npass_general\"    : os.path.join(BASE_NP, \"NPASS3.0_naturalproducts_generalinfo.txt\"),\n",
    "    \"npass_species_pair\": os.path.join(BASE_NP, \"NPASS3.0_naturalproducts_species_pair.txt\"),\n",
    "    \"npass_species_info\": os.path.join(BASE_NP, \"NPASS3.0_species_info.txt\"),\n",
    "    \"npass_activity\"   : os.path.join(BASE_NP, \"NPASS3.0_activities.txt\"),\n",
    "    \"npass_target\"     : os.path.join(BASE_NP, \"NPASS3.0_target.txt\"),\n",
    "    \"npass_toxicity\"   : os.path.join(BASE_NP, \"NPASS3.0_toxicity.txt\"),\n",
    "    \"coconut_sdf\"      : os.path.join(BASE_NP, \"coconut_complete-10-2024.sdf\"),\n",
    "    \"afrodb_sdf\"       : os.path.join(BASE_PROJ, \"data\", \"afrodb-04-2026.sdf\"),\n",
    "    \"output_dir\"       : os.path.join(MSC_PROJ, \"data\"),\n",
    "}\n",
    "    \n",
    "os.makedirs(PATHS[\"output_dir\"], exist_ok=True)\n",
