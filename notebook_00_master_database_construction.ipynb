   "source": [
    "# =============================================================================\n",
    "# SECTION 2: BUILD PLANT ANNOTATION TABLE\n",
    "#\n",
    "# One compound can come from multiple plants (many-to-many relationship).\n",
    "# Strategy: aggregate all source plants per np_id into semicolon-separated\n",
    "# strings. This preserves all provenance information in a single row per\n",
    "# compound — standard practice for NP databases in the literature.\n",
    "# =============================================================================\n",
    "\n",
    "# Step 2a: Link species_pair → species_info via org_id\n",
    "# This gives us: np_id → (species name, genus, family, kingdom, location)\n",
    "sp_merged = npass_sp_pair.merge(\n",
    "    npass_sp_info[[\n",
    "        \"org_id\", \"species_name\", \"genus_name\", \"family_name\",\n",
    "        \"kingdom_name\", \"org_name\"\n",
    "    ]],\n",
    "    on=\"org_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "# Step 2b: Aggregate per np_id — one compound may come from many plants\n",
    "# org_collect_location is the country/region field\n",
    "plant_annotation = (\n",
    "    sp_merged.groupby(\"np_id\")\n",
    "    .agg(\n",
    "        source_species   = (\"species_name\",         lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        source_genus     = (\"genus_name\",            lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        source_family    = (\"family_name\",           lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        source_kingdom   = (\"kingdom_name\",          lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        source_org_name  = (\"org_name\",              lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        collection_location = (\"org_collect_location\", lambda x: \"; \".join(sorted(set(x.dropna())))),\n",
    "        n_source_organisms = (\"org_id\",              \"nunique\"),\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(f\"Plant annotation table: {len(plant_annotation):,} unique np_ids\")\n",
    "print(f\"Example entry:\")\n",
    "print(plant_annotation[plant_annotation[\"n_source_organisms\"] > 1].head(2).T)"
   ]
  },
